---
import { equipoEncabezado, equipoAreas } from '../../data/equipo.js';
import { fuentesResponsive } from '../../lib/imagenes.js';
import SectionHeading from '../ui/SectionHeading.astro';

const TRATAMIENTOS = /^(dr|dra|lic)\.?$/i;

// Iniciales del primer y último nombre, sin el tratamiento (Dr./Dra./Lic.)
function iniciales(nombre) {
  const palabras = nombre
    .split(/\s+/)
    .filter((palabra) => palabra && !TRATAMIENTOS.test(palabra));
  if (palabras.length === 0) return '';
  const primera = palabras[0][0];
  const ultima = palabras.length > 1 ? palabras[palabras.length - 1][0] : '';
  return (primera + ultima).toUpperCase();
}

const mostrarAreas = equipoAreas.length > 1;
const SIZES = '(min-width: 1280px) 368px, (min-width: 1024px) 30vw, (min-width: 768px) 45vw, 88px';
const fondoDesktop = fuentesResponsive('equipo-fondo-desktop', [960, 1440, 1920]);
const fondoMobile = fuentesResponsive('equipo-fondo-mobile', [480, 720, 960]);
---

<section
  id="equipo"
  data-seccion-de="profesionales"
  class="bg-[var(--color-surface)] pb-14 md:pb-24"
>
  <!-- Sin JavaScript, el contenido animado se ve en su posición final -->
  <noscript>
    <style is:inline>
      #equipo .reveal { opacity: 1; transform: none; }
    </style>
  </noscript>

  <!-- La banda mide lo que el encabezado más el padding inferior de este contenedor -->
  <div class="relative isolate bg-[var(--color-navy-deep)] pb-10 pt-14 md:pb-[120px] md:pt-24 lg:pb-[100px]">
    <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <picture>
        <source media="(min-width: 1024px)" type="image/avif" srcset={fondoDesktop.avif} sizes="100vw" />
        <source media="(min-width: 1024px)" type="image/webp" srcset={fondoDesktop.webp} sizes="100vw" />
        <source type="image/avif" srcset={fondoMobile.avif} sizes="100vw" />
        <source type="image/webp" srcset={fondoMobile.webp} sizes="100vw" />
        <img
          src={fondoMobile.fallback}
          alt=""
          loading="lazy"
          class="h-full w-full object-cover object-[center_40%]"
        />
      </picture>
      <div class="eq-velo absolute inset-0"></div>
    </div>

    <div class="container">
      <SectionHeading
        eyebrow={equipoEncabezado.eyebrow}
        titulo={equipoEncabezado.titulo}
        bajada={equipoEncabezado.bajada}
        tema="oscuro"
        alineacion="izquierda"
      />
    </div>
  </div>

  <div class="container relative z-10">
    {
      equipoAreas.map((area, indiceArea) => (
        <div class={indiceArea === 0 ? '-mt-3 md:-mt-[72px] lg:-mt-[60px]' : 'mt-12 md:mt-16'}>
          {mostrarAreas && (
            <div class="mb-6 flex items-center gap-4">
              <h3 class="eq-area shrink-0 text-[var(--color-blue-dark)]">{area.nombre}</h3>
              <span class="h-px flex-1 bg-[var(--color-border)]" aria-hidden="true" />
            </div>
          )}

          <ul class="eq-lista flex flex-wrap justify-center gap-4 md:gap-6">
            {
              area.integrantes.map((integrante, indice) => {
                const foto = integrante.foto ? fuentesResponsive(integrante.foto, [320, 640]) : null;
                // Solo en mobile: recorte más cerca de la cara
                const miniatura = integrante.foto ? fuentesResponsive(`${integrante.foto}-thumb`, [176, 264]) : null;
                const matricula = integrante.matricula;
                return (
                  <li class={`eq-item reveal reveal-delay-${indice % 4}`}>
                    <article class="eq-card flex h-full items-start gap-4 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-4 md:flex-col md:items-stretch md:gap-0 md:p-0">
                      <div class="eq-foto relative aspect-[4/5] w-[88px] shrink-0 overflow-hidden rounded-[var(--radius)] md:w-full md:rounded-none lg:aspect-square">
                        {foto ? (
                          <picture>
                            <source media="(max-width: 767px)" type="image/avif" srcset={miniatura.avif} sizes="88px" />
                            <source media="(max-width: 767px)" type="image/webp" srcset={miniatura.webp} sizes="88px" />
                            <source type="image/avif" srcset={foto.avif} sizes={SIZES} />
                            <source type="image/webp" srcset={foto.webp} sizes={SIZES} />
                            <img
                              src={foto.fallback}
                              alt={integrante.fotoAlt}
                              width="640"
                              height="800"
                              loading="lazy"
                              class="eq-foto-img h-full w-full object-cover object-[50%_20%] lg:object-[center_30%]"
                            />
                          </picture>
                        ) : (
                          <div
                            class="eq-iniciales flex h-full w-full items-center justify-center bg-[var(--color-cyan-pale)] text-[var(--color-blue-dark)]"
                            role="img"
                            aria-label={integrante.fotoAlt}
                          >
                            <span aria-hidden="true">{iniciales(integrante.nombre)}</span>
                          </div>
                        )}
                      </div>

                      <div class="flex min-w-0 flex-1 flex-col md:p-5">
                        <h4 class="eq-nombre text-[17px] font-semibold leading-[1.25] text-[var(--color-ink)] md:text-[19px]">
                          {integrante.nombre}
                        </h4>
                        <p class="mt-1 max-w-none text-[13px] font-semibold leading-[1.35] text-[var(--color-blue-dark)] md:text-[14px]">
                          {integrante.cargo}
                        </p>
                        <p class="mt-2 max-w-none text-[14px] leading-[1.55] text-[var(--color-muted)] md:text-[15px]">
                          {integrante.descripcion}
                        </p>
                        {matricula && (
                          <p class="mt-auto max-w-none pt-3 text-[12px] leading-[1.4] text-[var(--color-muted)] md:text-[13px]">
                            {matricula}
                          </p>
                        )}
                      </div>
                    </article>
                  </li>
                );
              })
            }
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Grilla centrada: si la última fila queda incompleta, sus tarjetas se centran.
     1 columna en mobile, 2 en tablet, 3 desde 1024px y 4 desde 1280px. */
  .eq-item {
    width: 100%;
  }

  @media (min-width: 768px) {
    .eq-item {
      width: calc((100% - 1.5rem) / 2);
    }
  }

  @media (min-width: 1024px) {
    .eq-item {
      width: calc((100% - 3rem) / 3);
    }
  }

  @media (min-width: 1280px) {
    .eq-item {
      width: calc((100% - 4.5rem) / 4);
    }
  }

  .eq-area {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eq-nombre {
    font-family: var(--font-display);
  }

  .eq-iniciales {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  @media (min-width: 768px) {
    .eq-iniciales {
      font-size: 44px;
    }
  }

  .eq-velo {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-navy-deep) 86%, transparent),
      color-mix(in srgb, var(--color-navy-deep) 94%, transparent)
    );
  }

  .eq-card {
    box-shadow: 0 10px 32px color-mix(in srgb, var(--color-navy-deep) 18%, transparent);
    transition: box-shadow 250ms ease;
  }

  .eq-foto-img {
    transition: transform 400ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .eq-card:hover {
      box-shadow: var(--shadow-card-hover);
    }

    .eq-card:hover .eq-foto-img {
      transform: scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eq-card,
    .eq-foto-img {
      transition: none;
    }

    .eq-card:hover .eq-foto-img {
      transform: none;
    }
  }
</style>
